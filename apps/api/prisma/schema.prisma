generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  googleSub             String                 @unique
  email                 String                 @unique
  name                  String
  picture               String?
  role                  String                 @default("USER")
  status                String                 @default("ACTIVE")
  permissionsGrant      String[]               @default([])
  permissionsRevoke     String[]               @default([])
  lastLoginAt           DateTime?
  invitedBy             String?
  invitedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  alerts                Alert[]
  watchlists            Watchlist[]
  logs                  Log[]
  settings              Setting[]
  notificationChannels  NotificationChannel[]
  notificationTemplates NotificationTemplate[]
  notificationRules     NotificationRule[]
  priceHistory          PriceHistory[]
  userSettings          UserSetting[]
  portfolioHoldings     PortfolioHolding[]
  portfolioTransactions PortfolioTransaction[]
  portfolioAnalyses     PortfolioAnalysisRun[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model PortfolioHolding {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  quantity    Float
  averageCost Float
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
}

model PortfolioTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  type        String
  quantity    Float    @default(0)
  price       Float    @default(0)
  fees        Float    @default(0)
  taxes       Float    @default(0)
  amount      Float    @default(0)
  realizedPnl Float    @default(0)
  note        String?
  tradedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, symbol, tradedAt(sort: Desc)])
  @@index([symbol])
  @@index([type])
}

model PortfolioAnalysisRun {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String
  reason         String
  totalCost      Float
  currentValue   Float
  unrealizedGain Float
  gainPct        Float
  riskScore      Float
  summary        String
  decisions      Json     @default("[]")
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model Role {
  key         String   @id
  name        String
  description String?
  isSystem    Boolean  @default(false)
  rank        Int      @default(0)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rank])
}

model Alert {
  id               String    @id
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol           String
  targetPrice      Float
  condition        String
  status           String    @default("ACTIVE")
  priority         String    @default("MEDIUM")
  note             String?
  lastCheckedPrice Float?
  createdAt        DateTime  @default(now())
  triggeredAt      DateTime?

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([symbol])
}

model Watchlist {
  id            String   @id
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  symbols       String[]
  symbolAddedAt Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Log {
  id        String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Setting {
  key    String @id
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  String

  @@index([userId])
}

model UserSetting {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@unique([userId, key])
  @@index([userId])
}

model NotificationChannel {
  id          String                 @id @default(cuid())
  userId      String?
  user        User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String
  enabled     Boolean                @default(true)
  config      Json                   @default("{}")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  rules       NotificationRule[]
  templates   NotificationTemplate[]

  @@index([userId])
  @@index([type])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  event     String
  channelId String?
  channel   NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  body      String
  subject   String?
  isDefault Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  rules     NotificationRule[]

  @@index([userId])
  @@index([event])
  @@index([channelId])
}

model NotificationRule {
  id            String                @id @default(cuid())
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  event         String
  enabled       Boolean               @default(true)
  priority      Int                   @default(0)
  filters       Json                  @default("{}")
  channelId     String
  channel       NotificationChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  templateId    String?
  template      NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  cooldownMin   Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([userId])
  @@index([event, enabled])
}

model PriceHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  price     Float
  source    String
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([symbol, timestamp(sort: Desc)])
}
