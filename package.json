{
  "name": "tradeping",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "kill:ports": "node scripts/kill-dev-ports.js 3000 3001 3002 4000 4001 4002 4003 4004 4005 4006 4007 4008 4009",
    "kill:ports:api": "node scripts/kill-dev-ports.js 4000 4001 4002 4003 4004 4005 4006 4007 4008 4009",
    "kill:ports:web": "node scripts/kill-dev-ports.js 3000 3001 3002",
    "dev": "pnpm kill:ports && pnpm -r --parallel --filter @tradeping/api --filter @tradeping/web dev",
    "dev:api": "pnpm kill:ports:api && pnpm --filter @tradeping/api dev",
    "dev:web": "pnpm kill:ports:web && pnpm --filter @tradeping/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .prettierignore",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
